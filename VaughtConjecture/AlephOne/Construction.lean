import InfinitaryLogic.TwoGeneratorCardinality
import VaughtConjecture.AlephOne.Conditions
import VaughtConjecture.Continuation.ExactAge
import VaughtConjecture.Language.Density
import VaughtConjecture.Realization.Receiving
import VaughtConjecture.Realization.ReceivingLimit

/-!
# One receiving model of cardinality `ℵ₁`: the statements of the Zorn construction

Stage 3 of the `ℵ₁` companion construction, on the conditions of
`VaughtConjecture.AlephOne.Conditions`.  The exported class at stage `ω₁` is
`R.IsReceivingModel ∧ R.HasTopFreeTypes`.

**Existence (construction).**

* `AlephOne.ExistsUnboundedScheduleTarget`: an unbounded schedule of requests exists (from
  `AlephOne.RequestCardinalityTarget`, at most `ℵ₁` requests, and a pairing of `ω₁` with
  `ω₁ × ω₁`).  Stated; open.
* `AlephOne.InitialConditionTarget` and `AlephOne.ChainUnionTarget`: the initial condition, and the
  union of a nonempty chain of conditions as an upper bound with the union of the domains as its
  domain, for chains of any length.  Proved.
* `AlephOne.OnePointExtensionTarget`: a condition of countable domain extends by one point
  (the exact one-point attachment `Realization.optionAttachmentTarget` on the domain, transported
  along the bijection of `Option dom` with the domain and its least missing point).  Stated; open.
* `AlephOne.MaximalFullHeightTarget` (a maximal condition has the whole carrier as its domain) and
  `AlephOne.ExistsFullHeightConditionTarget`: proved from `AlephOne.OnePointExtensionTarget`
  (`AlephOne.maximalFullHeightTarget_of_onePointExtension`) with Zorn's lemma
  (`AlephOne.existsFullHeightConditionTarget_of_maximalFullHeight`); proper lower sets of the
  carrier are countable (`AlephOne.countable_of_isLowerSet_ne_univ`, proved).
* `AlephOne.FullHeightExactReceivingTarget`: a condition of full domain for an unbounded schedule
  has exact top-free receiving, from the served requests.  Proved.
* `AlephOne.IsReceivingModelOfExactReceivingTarget` (given-model: exact top-free receiving makes a
  receiving model, by capping and cap-to-model; stated, open), and the composition
  `AlephOne.FullHeightIsReceivingModelTarget` (proved from it,
  `AlephOne.fullHeightIsReceivingModelTarget_of`).
* `AlephOne.ExistsReceivingModelTarget`: some realization on the carrier is in the class; proved
  from the schedule, the one-point extension and the given-model receiving target
  (`AlephOne.existsReceivingModelTarget_of`).

**Given-model statements** (about every member of the class, separate from existence).

* Cardinality: at most `ℵ₁` for every exactly consistent covering realization
  (`AlephOne.mk_le_aleph_one_of_isCovering`, proved here by InfinitaryLogic's `mk_le_aleph_one`
  for the canonical hull, two-generated by `Realization.exists_subset_card_le_two_finiteHull_eq`);
  at least `ℵ₁` for every model at stage `ω₁` (`AlephOne.AlephOneLeMkOfIsModelTarget`, from
  uniformity over the empty occurrence at each limit below `ω₁`; stated, open); exactly `ℵ₁` for the
  class (`AlephOne.MkEqAlephOneTarget`, proved from the lower bound).  The carrier of the
  construction has exactly `ℵ₁` points outright (`AlephOne.mk_carrier`).
* The base interpretation (the reduction to `ω`, read as a structure) of every receiving model at
  stage `ω₁` satisfies the density sentence (`AlephOne.RealizeDensitySentenceTarget`, proved).

## Placement

This file is Stage 3 (one model of cardinality `ℵ₁`) of the `ℵ₁` companion construction over the
density sentence; that construction is not yet recorded in `roadmap/COMPANIONS.md`.
-/

universe v

namespace VaughtConjecture.AlephOne

open Ordinal Set Realization FirstOrder Language

/-! ### Requests and schedules -/

/-- **Target: at most `ℵ₁` requests.**  Tuples of the carrier and stage types at `ω₁` on finitely
many points are at most `ℵ₁` many each.  Stated; open. -/
def RequestCardinalityTarget : Prop :=
  Cardinal.mk Request ≤ Cardinal.aleph 1

/-- **Target: an unbounded schedule exists**: some schedule schedules every request at points above
every point of the carrier.  Stated; open. -/
def ExistsUnboundedScheduleTarget : Prop :=
  ∃ s : Carrier → Request, IsUnboundedSchedule s

/-! ### Zorn's lemma on conditions -/

/-- **Target: the initial condition**: a condition with empty domain.  Proved
(`AlephOne.initialConditionTarget`). -/
def InitialConditionTarget : Prop :=
  ∀ s : Carrier → Request, ∃ c : Condition s, c.dom = ∅

/-- **The initial condition**, the target form (`AlephOne.Condition.initial`). -/
theorem initialConditionTarget : InitialConditionTarget :=
  fun s ↦ ⟨Condition.initial s, rfl⟩

/-- **Target: upper bounds of chains.**  Every chain of conditions, of any length, has an upper
bound; a nonempty chain has an upper bound whose domain is the union of the domains, so a chain
whose domains exhaust the carrier has an upper bound of full domain.  The upper bound is a
condition, so it serves the request scheduled at every point of its domain.  Proved
(`AlephOne.chainUnionTarget`). -/
def ChainUnionTarget : Prop :=
  ∀ (s : Carrier → Request) (C : Set (Condition s)), IsChain (· ≤ ·) C →
    (∃ ub : Condition s, ∀ c ∈ C, c ≤ ub) ∧
      (C.Nonempty → ∃ ub : Condition s, (∀ c ∈ C, c ≤ ub) ∧ ub.dom = ⋃ c ∈ C, c.dom)

/-- **Upper bounds of chains**, the target form (`AlephOne.Condition.exists_upperBound`,
`AlephOne.Condition.union`). -/
theorem chainUnionTarget : ChainUnionTarget := fun _ C hC ↦
  ⟨Condition.exists_upperBound C hC, fun hne ↦
    ⟨Condition.union C hC hne, fun _ hc ↦ Condition.le_union hC hne hc, rfl⟩⟩

/-- **Target: the one-point extension.**  A condition of countable domain extends to a condition
whose domain is the old domain with one more point.  The intended proof: the domain is
`Set.Iio x` for the least point `x` outside it; the realization on the domain
(`AlephOne.Condition.restrict`) is exactly consistent and covering with legal top-free types; the
request scheduled at `x`, if its tuple lies in the domain and its donor is a top-free coface of
the type of the tuple, gives the occurrence and the donor, and otherwise the bottom one-point type
over the empty occurrence does; `Realization.optionAttachmentTarget` (countability of the domain)
attaches the new point, and the result is transported along `Option dom ≃ insert x dom`.  Stated;
open. -/
def OnePointExtensionTarget : Prop :=
  ∀ (s : Carrier → Request) (c : Condition s), c.dom.Countable →
    ∃ c' : Condition s, c ≤ c' ∧ ∃ x ∉ c.dom, c'.dom = insert x c.dom

/-- **Proper lower sets of the carrier are countable**: such a set lies below a point outside it,
and the points below a point of `ω₁` are countably many. -/
theorem countable_of_isLowerSet_ne_univ {D : Set Carrier} (hD : IsLowerSet D)
    (hne : D ≠ Set.univ) : D.Countable := by
  obtain ⟨x, hx⟩ := (Set.ne_univ_iff_exists_notMem D).mp hne
  have hDx : D ⊆ Set.Iio x := fun y hy ↦ lt_of_not_ge fun hxy ↦ hx (hD hxy hy)
  refine Set.Countable.mono hDx ?_
  have h : (typein (α := Carrier) (· < ·) x).card < Cardinal.aleph 1 :=
    Cardinal.lt_omega_iff_card_lt.mp (typein_lt_self x)
  rw [Ordinal.card_typein, ← Cardinal.succ_aleph0, Order.lt_succ_iff] at h
  exact Cardinal.le_aleph0_iff_set_countable.mp h

/-- **Target: a maximal condition has full domain.**  Proved from the one-point extension
(`AlephOne.maximalFullHeightTarget_of_onePointExtension`). -/
def MaximalFullHeightTarget : Prop :=
  ∀ (s : Carrier → Request) (c : Condition s), IsMax c → c.dom = Set.univ

/-- **A maximal condition has full domain**, given the one-point extension: otherwise its domain
is a proper lower set, hence countable, and the one-point extension is strictly larger. -/
theorem maximalFullHeightTarget_of_onePointExtension (h : OnePointExtensionTarget) :
    MaximalFullHeightTarget := by
  intro s c hc
  by_contra hne
  obtain ⟨c', hcc', x, hx, hdom⟩ :=
    h s c (countable_of_isLowerSet_ne_univ c.isLowerSet_dom hne)
  exact hx ((hc hcc').1 (hdom ▸ Set.mem_insert x c.dom))

/-- **Target: a condition of full domain exists**, for every schedule.  Proved from
`AlephOne.MaximalFullHeightTarget` with Zorn's lemma
(`AlephOne.existsFullHeightConditionTarget_of_maximalFullHeight`). -/
def ExistsFullHeightConditionTarget : Prop :=
  ∀ s : Carrier → Request, ∃ c : Condition s, c.dom = Set.univ

/-- **A condition of full domain exists**, given that maximal conditions have full domain: Zorn's
lemma on conditions (`AlephOne.Condition.exists_isMax`, from the upper bounds of all chains). -/
theorem existsFullHeightConditionTarget_of_maximalFullHeight (h : MaximalFullHeightTarget) :
    ExistsFullHeightConditionTarget := fun s ↦
  (Condition.exists_isMax s).imp fun c hc ↦ h s c hc

/-! ### From a condition of full domain to the exported class -/

/-- **Target: exact top-free receiving from the served requests.**  For an unbounded schedule, the
realization of a condition of full domain has exact receiving within the legal top-free stage
types: over a cover `c` of `t`, a legal top-free one-point coface `D` of `t` is the request
`(c, D)`, scheduled at some point `γ` above every point of `c`, where it is served.  The
one-point form gives every arity (`Realization.ExactReceivingWithin.of_one_point`).  Proved
(`AlephOne.fullHeightExactReceivingTarget`). -/
def FullHeightExactReceivingTarget : Prop :=
  ∀ s : Carrier → Request, IsUnboundedSchedule s → ∀ c : Condition s, c.dom = Set.univ →
    c.real.ExactReceivingWithin fun _ ↦ {D | D.IsLegal ∧ D.IsTopFree}

/-- The carrier has no largest point: `ω₁` is a limit. -/
instance : NoMaxOrder Carrier := by
  rw [← isSuccPrelimit_type_lt_iff, type_toType]
  exact (Cardinal.isSuccLimit_omega 1).isSuccPrelimit

/-- Every finite tuple of the carrier lies below some point. -/
theorem exists_forall_lt {n : ℕ} (x : Fin n → Carrier) : ∃ b : Carrier, ∀ i, x i < b := by
  rcases isEmpty_or_nonempty (Fin n) with hn | hn
  · exact ⟨Classical.arbitrary Carrier, fun i ↦ isEmptyElim i⟩
  obtain ⟨i₀, -, hi₀⟩ := Finset.exists_max_image Finset.univ x Finset.univ_nonempty
  obtain ⟨b, hb⟩ := exists_gt (x i₀)
  exact ⟨b, fun i ↦ (hi₀ i (Finset.mem_univ _)).trans_lt hb⟩

/-- **Exact top-free receiving from the served requests**, the target form: over a cover `x` of
`t`, the request `(x, D)` is scheduled at a point `γ` above every point of `x`, and the condition
serves it there; the one-point form gives every arity
(`Realization.ExactReceivingWithin.of_one_point`, the legal top-free stage types being closed under
the face maps). -/
theorem fullHeightExactReceivingTarget : FullHeightExactReceivingTarget := by
  intro s hs c hc
  refine ExactReceivingWithin.of_one_point c.isConsistent
    (fun _ _ _ f _ hD hp ↦ ⟨hD.1.restrictFace f hp, hD.2.restrictFace hp⟩) ?_
  intro n t x hx D hD hDt
  obtain ⟨hinj, hxt⟩ := hx
  obtain ⟨b, hb⟩ := exists_forall_lt x
  obtain ⟨γ, hbγ, hγ⟩ := hs ⟨n, ⟨x, hinj⟩, D⟩ b
  have hserv := c.serves γ (hc ▸ Set.mem_univ γ)
  rw [hγ] at hserv
  have hlt : ∀ i, x i < γ := fun i ↦ (hb i).trans_le hbγ
  have heval := hserv hlt t hxt ⟨hD.1, hDt⟩ hD.2
  refine ⟨_, covers_of_eval _ heval, funext fun i ↦ ?_⟩
  simp [Request.extendAt]

/-- **Target: exact top-free receiving makes a receiving model** (given-model statement).  At a
limit stage, an exactly consistent covering realization on a nonempty carrier with legal top-free
types and exact receiving within the legal top-free stage types is a receiving model: finite-cut
receiving by capping each coface at an ordinal above the cutoff and the labels of the occurrence,
then modelhood by `Realization.isModel_of_hasFiniteCutReceiving`.  Stated; open. -/
def IsReceivingModelOfExactReceivingTarget : Prop :=
  ∀ ⦃α : Ordinal.{0}⦄ ⦃M : Type v⦄, Order.IsSuccLimit α → ∀ R : Realization.{0, v} α M,
    Nonempty M → R.IsConsistent → R.IsCovering → R.HasLegalTypes → R.HasTopFreeTypes →
      R.ExactReceivingWithin (fun _ ↦ {D | D.IsLegal ∧ D.IsTopFree}) → R.IsReceivingModel

/-- **Target: a condition of full domain gives a member of the exported class.**  For an
unbounded schedule, the realization of a condition of full domain is a receiving model with
top-free types.  Proved from `AlephOne.IsReceivingModelOfExactReceivingTarget`
(`AlephOne.fullHeightIsReceivingModelTarget_of`), with exact receiving from
`AlephOne.fullHeightExactReceivingTarget`. -/
def FullHeightIsReceivingModelTarget : Prop :=
  ∀ s : Carrier → Request, IsUnboundedSchedule s → ∀ c : Condition s, c.dom = Set.univ →
    c.real.IsReceivingModel ∧ c.real.HasTopFreeTypes

/-- **A condition of full domain gives a member of the exported class**, given the given-model
passage from exact receiving to receiving models; exact receiving is
`AlephOne.fullHeightExactReceivingTarget`. -/
theorem fullHeightIsReceivingModelTarget_of (hmodel : IsReceivingModelOfExactReceivingTarget.{0}) :
    FullHeightIsReceivingModelTarget :=
  fun s hs c hc ↦
    ⟨hmodel (Cardinal.isSuccLimit_omega 1) c.real inferInstance c.isConsistent
      (c.isCovering_of_dom_eq_univ hc) c.hasLegalTypes c.hasTopFreeTypes
      (fullHeightExactReceivingTarget s hs c hc),
      c.hasTopFreeTypes⟩

/-- **Target: a member of the exported class on the carrier.**  Some realization at stage `ω₁` on
the carrier `ω₁.ToType` (a type in `Type`, of cardinality `ℵ₁`) is a receiving model with
top-free types.  Existence statement.  Proved from its inputs
(`AlephOne.existsReceivingModelTarget_of`). -/
def ExistsReceivingModelTarget : Prop :=
  ∃ R : Realization.{0, 0} (ω₁ : Ordinal.{0}) Carrier, R.IsReceivingModel ∧ R.HasTopFreeTypes

/-- **A member of the exported class on the carrier**, given an unbounded schedule, the one-point
extension, and the given-model passage from exact receiving to receiving models: Zorn's lemma
gives a condition of full domain. -/
theorem existsReceivingModelTarget_of (hsched : ExistsUnboundedScheduleTarget)
    (hext : OnePointExtensionTarget) (hmodel : IsReceivingModelOfExactReceivingTarget.{0}) :
    ExistsReceivingModelTarget := by
  obtain ⟨s, hs⟩ := hsched
  obtain ⟨c, hc⟩ := existsFullHeightConditionTarget_of_maximalFullHeight
    (maximalFullHeightTarget_of_onePointExtension hext) s
  exact ⟨c.real, fullHeightIsReceivingModelTarget_of hmodel s hs c hc⟩

/-! ### Given-model statements: cardinality and the density sentence -/

/-- **At most `ℵ₁` points** (InfinitaryLogic's `mk_le_aleph_one` for the canonical finite hull,
which is generated by two points, `Realization.exists_subset_card_le_two_finiteHull_eq`): the
carrier of an exactly consistent covering realization, at any stage, has at most `ℵ₁` points. -/
theorem mk_le_aleph_one_of_isCovering {α : Ordinal.{0}} {M : Type v}
    {R : Realization.{0, v} α M} (hR : R.IsConsistent) (hc : R.IsCovering) :
    Cardinal.mk M ≤ Cardinal.aleph 1 :=
  InfinitaryLogic.FiniteSupportClosure.mk_le_aleph_one (R.hullClosure hR hc)
    (exists_subset_card_le_two_finiteHull_eq hR hc)

/-- **Target: at least `ℵ₁` points** (given-model statement).  A model at stage `ω₁` has at least
`ℵ₁` points: by uniformity over the empty occurrence, for each limit `γ < ω₁` some point has a
one-point type with a label in `[γ, γ + ω)`; these intervals are disjoint for distinct limits and
a type has finitely many labels, so the map from the `ℵ₁` limits below `ω₁` to points is
finite-to-one.  Stated; open. -/
def AlephOneLeMkOfIsModelTarget : Prop :=
  ∀ ⦃M : Type v⦄ (R : Realization.{0, v} (ω₁ : Ordinal.{0}) M), R.IsModel →
    Cardinal.aleph 1 ≤ Cardinal.mk M

/-- **Target: exactly `ℵ₁` points** for every member of the exported class (given-model
statement).  Proved from `AlephOne.AlephOneLeMkOfIsModelTarget`
(`AlephOne.mkEqAlephOneTarget_of`); the upper bound is `AlephOne.mk_le_aleph_one_of_isCovering`. -/
def MkEqAlephOneTarget : Prop :=
  ∀ ⦃M : Type v⦄ (R : Realization.{0, v} (ω₁ : Ordinal.{0}) M), R.IsReceivingModel →
    R.HasTopFreeTypes → Cardinal.mk M = Cardinal.aleph 1

/-- **Exactly `ℵ₁` points** for the class, given the lower bound for models; top-freeness is not
used. -/
theorem mkEqAlephOneTarget_of (h : AlephOneLeMkOfIsModelTarget.{v}) : MkEqAlephOneTarget.{v} :=
  fun _ R hR _ ↦ le_antisymm (mk_le_aleph_one_of_isCovering hR.1.isConsistent hR.1.isCovering)
    (h R hR.1)

/-- **Target: the base interpretation satisfies the density sentence** (given-model statement).
For every receiving model at stage `ω₁`, the structure of its reduction to `ω` satisfies the
density sentence.  Proved (`AlephOne.realizeDensitySentenceTarget`). -/
def RealizeDensitySentenceTarget : Prop :=
  ∀ ⦃M : Type v⦄ (R : Realization.{0, v} (ω₁ : Ordinal.{0}) M), R.IsReceivingModel →
    @Sentenceω.Realize _ baseLanguage.densitySentence.{0} M
      (R.reduce Ordinal.isSuccLimit_omega0.isSuccPrelimit).toStructure

/-- **The base interpretation satisfies the density sentence**: the reduction to `ω` keeps legal
types, exact consistency and covering (`Realization.HasLegalTypes.reduce`,
`Realization.IsConsistent.reduce`, `Realization.IsCovering.reduce`) and finite-cut receiving
(`Realization.HasFiniteCutReceiving.reduce`, since `ω ≤ ω₁`), and these with a nonempty carrier
are the density sentence (`baseLanguage.realize_toStructure_densitySentence_iff`). -/
theorem realizeDensitySentenceTarget : RealizeDensitySentenceTarget.{v} := by
  intro M R hR
  have hβ := Ordinal.isSuccLimit_omega0.isSuccPrelimit
  exact (baseLanguage.realize_toStructure_densitySentence_iff (hR.1.hasLegalTypes.reduce hβ)).mpr
    ⟨hR.1.nonempty, hR.1.isConsistent.reduce hβ, hR.1.isCovering.reduce hβ,
      hR.2.reduce (Cardinal.isSuccLimit_omega 1).isSuccPrelimit hβ (Ordinal.omega0_le_omega 1)⟩

end VaughtConjecture.AlephOne
