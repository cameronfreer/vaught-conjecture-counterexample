import InfinitaryLogic.ModelTheory.ArbitraryStabilization
import VaughtConjecture.MainTheorem.Spectrum
import VaughtConjecture.ProcessRank.RankConventions
import VaughtConjecture.ProcessRank.Reconstruction

/-!
# Countable exceptions: models of uncountable process rank

Companion programme over the density sentence, process rank `ω₁`.  Conventions as in
`VaughtConjecture.ProcessRank.RankConventions`: `r(a) = orbitRank a`, `R(M) = sup_a (r(a))`.
This file proves the countable-exception statement `ProcessRankLtOfCountableExceptionsTarget` of
`VaughtConjecture.ProcessRank.Reconstruction`: if a sentence `ψ` of `L_{ω₁,ω}` fails in only
countably many isomorphism classes of models of the density sentence coded on `ℕ`, then `ψ` holds
in every model of the density sentence, on a carrier in any universe, with `R(M)` at least the
lift of `ω₁`.

**Potential isomorphism with a countable structure** (generic, carriers in one universe).

* `orbitRank_le_lift_scottHeight_of_potentialIso`: if `C` is countable and potentially isomorphic
  to `N`, every `r(a)` in `N` is at most the lift of the Scott height of `C`.  Tuples of `N` are
  matched to tuples of `C` equivalent at every level, and `C` stabilizes at its Scott height
  (InfinitaryLogic's `orbitRank_le_lift_scottHeight`).  So `R(N)` is countable
  (`iSup_orbitRank_lt_omegaOne_of_potentialIso`).
* `nonempty_potentialIso_of_bfEquiv_scottHeight`: if the empty tuples of a countable `C` and an
  arbitrary `N` are equivalent at the Scott height of `C`, then `C` and `N` are potentially
  isomorphic.  The stabilization of `C` at its Scott height holds against arbitrary targets
  (InfinitaryLogic's `bfEquiv_all_of_stabilizesCompletely_arbitrary`, through countable
  substructures elementary for the fragment of the Scott formulas of `C`).  With
  `realize_scottFormula_iff_BFEquiv` this is the same-universe case of
  `PotentialIsoOfRealizeCanonicalScottSentenceTarget`
  (`nonempty_potentialIso_of_realize_canonicalScottSentence`).

**The exception argument** (`processRankLtOfCountableExceptionsTarget`).  Suppose `M` satisfies
the density sentence, fails `ψ` and has `R(M) ≥ ω₁`.  For every exceptional class `q` take a copy
`classCarrier q` of its chosen code on a carrier in the universe of `M`, and the closed Scott
formula of the empty tuple of that copy at its Scott height.  The fragment generated by the
density sentence, `ψ` and these countably many closed formulas is countable, so `M` has a
countable substructure `M₀` elementary for it (InfinitaryLogic's
`exists_countable_aElementary_substructure`).  `M₀` satisfies the density sentence and fails `ψ`,
so it is isomorphic to a code on `ℕ` failing `ψ`
(`MainTheorem.exists_mem_modelsOf_densitySentence_equiv`): its class `q` is exceptional, and `M₀`
is isomorphic to `classCarrier q`.  So `M₀` satisfies the closed Scott formula of `q`, hence so
does `M`; `M` is potentially isomorphic to the countable `classCarrier q`, and `R(M)` is
countable, a contradiction.

**Results.**  All proved.
-/

universe u v w

namespace VaughtConjecture.ProcessRank

open Ordinal FirstOrder Language

/-! ### Potential isomorphism with a countable structure -/

section Generic

variable {L : Language.{u, v}} [L.IsRelational] [Countable (Σ l, L.Relations l)]
  {C N : Type w} [L.Structure C] [L.Structure N] [Countable C]

/-- **Orbit ranks under potential isomorphism with a countable structure**: every `r(a)` in `N`
is at most the lift of the Scott height of `C`.  The tuples `a`, `a'` of `N` are matched to
tuples `c`, `c'` of `C` equivalent to them at every level; equivalence of `a` and `a'` at the
lifted Scott height is equivalence of `c` and `c'` there, hence at every level
(`orbitRank_le_lift_scottHeight`), hence so are `a` and `a'`. -/
theorem orbitRank_le_lift_scottHeight_of_potentialIso (P : PotentialIso L C N) {n : ℕ}
    (a : Fin n → N) :
    orbitRank (L := L) a ≤ Ordinal.lift.{w} (scottHeight (L := L) C) := by
  refine orbitRank_le_of_mem fun a' ha γ ↦ ?_
  obtain ⟨c, hc⟩ := P.symm.exists_right a
  obtain ⟨c', hc'⟩ := P.symm.exists_right a'
  have hac : ∀ β : Ordinal.{w}, BFEquiv (L := L) β n a c := fun β ↦ P.symm.family_bfEquiv β hc
  have hac' : ∀ β : Ordinal.{w}, BFEquiv (L := L) β n a' c' :=
    fun β ↦ P.symm.family_bfEquiv β hc'
  have hcc : BFEquiv (L := L) (Ordinal.lift.{w} (scottHeight (L := L) C)) n c c' :=
    ((hac _).symm.trans ha).trans (hac' _)
  have hall := bfEquiv_all_of_bfEquiv_orbitRank
    (BFEquiv.monotone (orbitRank_le_lift_scottHeight c) hcc) γ
  exact ((hac γ).trans hall).trans (hac' γ).symm

/-- **Countable process rank under potential isomorphism with a countable structure**:
`R(N)` is below the lift of `ω₁`. -/
theorem iSup_orbitRank_lt_omegaOne_of_potentialIso (P : PotentialIso L C N) :
    (⨆ x : (Σ n : ℕ, Fin n → N), orbitRank (L := L) x.2) <
      Ordinal.lift.{w} (ω₁ : Ordinal.{0}) :=
  (iSup_orbitRank_le_iff.2 fun _ a ↦ orbitRank_le_lift_scottHeight_of_potentialIso P a).trans_lt
    (Ordinal.lift_lt.2 (scottHeight_lt_omega1 (L := L) C))

/-- **Potential isomorphism from equivalence at the Scott height**: if the empty tuples of the
countable `C` and of `N` are equivalent at the Scott height of `C`, they are equivalent at every
level (InfinitaryLogic's `bfEquiv_all_of_stabilizesCompletely_arbitrary`), so `C` and `N` are
potentially isomorphic (`potentialIso_iff_BFEquiv_all`). -/
theorem nonempty_potentialIso_of_bfEquiv_scottHeight
    (h : BFEquiv (L := L) (scottHeight (L := L) C) 0 (Fin.elim0 : Fin 0 → C)
      (Fin.elim0 : Fin 0 → N)) :
    Nonempty (PotentialIso L C N) :=
  potentialIso_iff_BFEquiv_all.2 fun β ↦ bfEquiv_all_of_stabilizesCompletely_arbitrary
    (scottHeight_lt_omega1 C) (scottHeight_stabilizesCompletely C) h β

/-- **The canonical Scott sentence of a countable structure, on carriers in one universe**: a
structure satisfying it is potentially isomorphic to the countable structure.  This is
`PotentialIsoOfRealizeCanonicalScottSentenceTarget` for carriers in one universe. -/
theorem nonempty_potentialIso_of_realize_canonicalScottSentence
    (h : (canonicalScottSentence (L := L) C).realize_as_sentence N) :
    Nonempty (PotentialIso L C N) := by
  unfold canonicalScottSentence Formulaω.realize_as_sentence at h
  rw [realize_scottFormula_iff_BFEquiv _ _ _ (scottHeight_lt_omega1 C)] at h
  exact nonempty_potentialIso_of_bfEquiv_scottHeight h

end Generic

/-! ### The exception argument -/

/-- The **carrier of an isomorphism class** of models coded on `ℕ`, in the universe `w`: a copy
of `ℕ`, with the structure of the chosen code of the class. -/
def classCarrier (_q : Quotient (isoSetoid baseLanguage.densitySentence.{0})) : Type w :=
  ULift.{w} ℕ

/-- The structure of the chosen code of the class, induced on the copy of `ℕ`. -/
noncomputable instance (q : Quotient (isoSetoid baseLanguage.densitySentence.{0})) :
    baseLanguage.{0}.Structure (classCarrier.{w} q) :=
  letI := q.out.1.toStructure
  (Equiv.ulift.symm : ℕ ≃ ULift.{w} ℕ).inducedStructure

instance (q : Quotient (isoSetoid baseLanguage.densitySentence.{0})) :
    Countable (classCarrier.{w} q) :=
  inferInstanceAs (Countable (ULift.{w} ℕ))

/-- The chosen code of a class is isomorphic to its copy on `classCarrier q`. -/
noncomputable def classCarrierEquiv (q : Quotient (isoSetoid baseLanguage.densitySentence.{0})) :
    @Language.Equiv baseLanguage.{0} ℕ (classCarrier.{w} q) q.out.1.toStructure _ :=
  letI := q.out.1.toStructure
  (Equiv.ulift.symm : ℕ ≃ ULift.{w} ℕ).inducedStructureEquiv

/-- The **closed Scott formula of a class**: the Scott formula of the empty tuple of
`classCarrier q` at its Scott height, with no free variables. -/
noncomputable def closedScottOfClass (q : Quotient (isoSetoid baseLanguage.densitySentence.{0})) :
    Σ n, baseLanguage.{0}.BoundedFormulaω Empty n :=
  ⟨0, (scottFormula (L := baseLanguage.{0}) (Fin.elim0 : Fin 0 → classCarrier.{w} q)
    (scottHeight (L := baseLanguage.{0}) (classCarrier.{w} q))).relabel
      (Sum.inr : Fin 0 → Empty ⊕ Fin 0)⟩

/-- **Countable exceptions**, the target form (see the module documentation). -/
theorem processRankLtOfCountableExceptionsTarget :
    ProcessRankLtOfCountableExceptionsTarget.{w} := by
  intro ψ hE M _ hΦ hR
  by_contra hψ
  classical
  set E := Quotient.mk (isoSetoid baseLanguage.densitySentence.{0}) '' {c | c.1 ∉ ModelsOf ψ}
    with hEdef
  let S : Set (Σ n, baseLanguage.{0}.BoundedFormulaω Empty n) :=
    insert ⟨0, baseLanguage.densitySentence.{0}⟩ {⟨0, ψ⟩} ∪ closedScottOfClass.{w} '' E
  have hS : S.Countable := ((Set.countable_singleton _).insert _).union (hE.image _)
  have : Countable (Σ n, baseLanguage.{0}.Functions n) := countable_functions_of_isRelational
  obtain ⟨M₀, -, hAe, hM₀⟩ := exists_countable_aElementary_substructure
    (Fragment.generated S) (X := (∅ : Set M)) Set.countable_empty (Fragment.generated_countable hS)
  have hcomp : (⇑M₀.subtype ∘ (Fin.elim0 : Fin 0 → M₀)) = Fin.elim0 := funext fun i ↦ i.elim0
  -- sentences of `S` transfer between `M₀` and `M`
  have hsent : ∀ φ : baseLanguage.{0}.Sentenceω, (⟨0, φ⟩ : Σ n, _) ∈ S →
      (Sentenceω.Realize φ M₀ ↔ Sentenceω.Realize φ M) := by
    intro φ hφ
    rw [Sentenceω.realize_def, Sentenceω.realize_def]
    have h := hAe φ (Fragment.subset_generated S hφ) Fin.elim0
    rw [hcomp] at h
    exact h.symm
  have hΦ₀ : Sentenceω.Realize baseLanguage.densitySentence.{0} M₀ :=
    (hsent _ (Set.mem_union_left _ (Set.mem_insert _ _))).2 hΦ
  have hψ₀ : ¬ Sentenceω.Realize ψ M₀ := fun h ↦
    hψ ((hsent _ (Set.mem_union_left _ (Set.mem_insert_of_mem _ rfl))).1 h)
  -- the class of `M₀` is exceptional
  obtain ⟨c, hc, ⟨e⟩⟩ := MainTheorem.exists_mem_modelsOf_densitySentence_equiv M₀ hΦ₀
  set q := Quotient.mk (isoSetoid baseLanguage.densitySentence.{0}) ⟨c, hc⟩ with hqdef
  have hq : q ∈ E := ⟨⟨c, hc⟩, fun hmem ↦ hψ₀ (by
    let := c.toStructure
    exact (MainTheorem.realize_sentenceω_equiv e ψ).2 ((mem_modelsOf_iff_realize c ψ).1 hmem)),
    rfl⟩
  -- `M₀` is isomorphic to `classCarrier q`
  obtain ⟨e''⟩ : Nonempty (@Language.Equiv baseLanguage.{0} ℕ ℕ q.out.1.toStructure
      c.toStructure) :=
    Quotient.mk_out (s := isoSetoid _) (⟨c, hc⟩ : ModelsOf baseLanguage.densitySentence.{0})
  let e' := @Language.Equiv.symm baseLanguage.{0} ℕ ℕ q.out.1.toStructure c.toStructure e''
  let f : M₀ ≃[baseLanguage.{0}] classCarrier.{w} q :=
    @Language.Equiv.comp baseLanguage.{0} M₀ ℕ _ c.toStructure (classCarrier.{w} q) _
      (@Language.Equiv.comp baseLanguage.{0} ℕ ℕ c.toStructure q.out.1.toStructure
        (classCarrier.{w} q) _ (classCarrierEquiv.{w} q) e') e
  -- `M` satisfies the closed Scott formula of `q`
  have hα := scottHeight_lt_omega1 (L := baseLanguage.{0}) (classCarrier.{w} q)
  have h₀ : BFEquiv (L := baseLanguage.{0}) (scottHeight (L := baseLanguage.{0})
      (classCarrier.{w} q)) 0 (Fin.elim0 : Fin 0 → classCarrier.{w} q)
      (Fin.elim0 : Fin 0 → M₀) := by
    have h := equiv_implies_BFEquiv f.symm (scottHeight (L := baseLanguage.{0})
      (classCarrier.{w} q)) 0 (Fin.elim0 : Fin 0 → classCarrier.{w} q)
    rwa [show (⇑f.symm ∘ (Fin.elim0 : Fin 0 → classCarrier.{w} q)) = Fin.elim0 from
      funext fun i ↦ i.elim0] at h
  have hM : BFEquiv (L := baseLanguage.{0}) (scottHeight (L := baseLanguage.{0})
      (classCarrier.{w} q)) 0 (Fin.elim0 : Fin 0 → classCarrier.{w} q) (Fin.elim0 : Fin 0 → M) := by
    have hmem : closedScottOfClass.{w} q ∈ (Fragment.generated S).toSet :=
      Fragment.subset_generated S (Set.mem_union_right _ ⟨q, hq, rfl⟩)
    have h := hAe _ hmem Fin.elim0
    rw [hcomp] at h
    rw [← realize_scottFormula_iff_BFEquiv _ _ _ hα, ← realize_closedScott_iff _ _ _] at h₀ ⊢
    exact h.2 h₀
  obtain ⟨P⟩ := nonempty_potentialIso_of_bfEquiv_scottHeight hM
  exact (iSup_orbitRank_lt_omegaOne_of_potentialIso P).not_ge hR

end VaughtConjecture.ProcessRank
