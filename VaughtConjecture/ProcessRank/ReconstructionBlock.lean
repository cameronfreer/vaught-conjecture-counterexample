import VaughtConjecture.ProcessRank.ReconstructionExceptions
import VaughtConjecture.ProcessRank.ReconstructionLocal

/-!
# Receiving expansions to the countable block stages of the models of uncountable process rank

Companion programme over the density sentence, process rank `ω₁`.  Conventions as in
`VaughtConjecture.ProcessRank.RankConventions`: `r(a) = orbitRank a`, `R(M) = sup_a (r(a))`.
This file proves `ExistsReceivingBlockExpansionOfProcessRankTarget` of
`VaughtConjecture.ProcessRank.Reconstruction`: a model `M` of the density sentence, on a carrier in
any universe, with `R(M)` at least the lift of `ω₁`, has at every countable block index `η` a
model expansion to `λ_η` with the finite-cut receiving property.  With the gluing at `ω₁` it gives
the reconstruction `ExistsReceivingExpansionOfProcessRankTarget`, and with milestone 1 the
uniqueness of the class of internal Scott rank `ω₁` among all models
(`internalRankOmegaOnePotentialIsoTarget`).

**The readings.**  At `λ_η` the chart predicates of a receiving model expansion are defined by the
block formulas of the forcing thresholds (`realize_blockFormula_iff_of_hasFiniteCutReceiving`,
from `realize_blockFormula_iff_of_determinesAt`: the reductions to the next block stages are
receiving models, which have block determination).  The **block reading** of `M`
(`blockReading`) evaluates a tuple to the stage type whose block formula it satisfies, and to
`none` when there is none.

**Local agreement** (`blockReading_comapRealization_eq`).  Let `M₀` be a substructure of `M`
elementary for a fragment containing the closed block formulas of all stage types at `λ_η`, with a
receiving model expansion `e` to `λ_η`.  Then `e` is the pullback of the block reading of `M`,
undefined evaluations included: a tuple of `M₀` satisfies a block formula in `M` exactly when it
does in `M₀`, exactly when `e` evaluates it to that type.

**The construction** (`existsReceivingBlockExpansionOfProcessRankTarget`).  The fragment is
generated by the density sentence, the closed block formulas at `λ_η` (countably many,
`StageType.countable_sigma`) and the closed Scott formulas of the classes outside the receiving
expansion domain at `η` (countably many, `receivingExpansionDomain_compl_countable`).  Every finite
set of `M` lies in a countable substructure `M₀` elementary for it.  `M₀` satisfies the density
sentence, so it is isomorphic to a code; its class is in the receiving expansion domain, since
otherwise `R(M)` would be countable (`iSup_orbitRank_lt_omegaOne_of_aElementary`).  So `M₀` has a
receiving model expansion to `λ_η`, which is the pullback of the block reading.  Being a model,
having finite-cut receiving and having the base structure of `M` as reduct are local
(`isModel_of_forall_comap`, `hasFiniteCutReceiving_of_forall_comap`,
`toStructure_reduce_eq_of_forall_comap`), so the block reading is a receiving model expansion
of `M`.

**Results.**  All proved.
-/

universe w

namespace VaughtConjecture.ProcessRank

open Ordinal _root_.Order FirstOrder Language Expansion

/-! ### Block formulas at a countable block stage -/

/-- **Block formulas define the charts of a receiving model expansion at `λ_η`**: in a model
expansion to `λ_η`, `η < ω₁`, with the finite-cut receiving property, the formula of the forcing
thresholds of `t` holds of exactly the covers of `t`.  The reductions to the next block stages
below are receiving models at limit stages, which have block determination for the forcing
thresholds. -/
theorem realize_blockFormula_iff_of_hasFiniteCutReceiving {N : Type w}
    [baseLanguage.{0}.Structure N] {η : Ordinal.{0}} (hη : η < ω₁)
    (e : ModelExpansion N (blockStage η)) (he : e.1.HasFiniteCutReceiving) {k : ℕ}
    (t : StageType.{0} (blockStage η) k) (c : Fin k → N) :
    (blockFormula forcingThresholds η hη t).Realize c ↔ e.1.Covers t c := by
  refine realize_blockFormula_iff_of_determinesAt forcingThresholds hη e (fun ξ hξ ↦ ?_) t c
  have hS := (show e.1.IsReceivingModel from ⟨e.2.isModel, he⟩).reduce
    (isSuccPrelimit_blockStage η) (isSuccLimit_blockStage (ξ + 1))
    (blockStage_mono (Order.add_one_le_of_lt hξ))
  exact forcingThresholds_determinesAt hS.1.isConsistent hS.1.hasLegalTypes
    (hS.2.hasFiniteExtensionReceiving hS.1.isConsistent (isSuccPrelimit_blockStage (ξ + 1)))
    (forcingDonors_of_hasApexCoatomExtensions
      (StageType.hasApexCoatomExtensions (isSuccPrelimit_blockStage (ξ + 1))))

/-- The **closed block formula** of a stage type at `λ_η`: its block formula, with the free
variables made the variables of a bounded formula with no free variables. -/
noncomputable def closedBlockFormula {η : Ordinal.{0}} (hη : η < ω₁) {k : ℕ}
    (t : StageType.{0} (blockStage η) k) : Σ n, baseLanguage.{0}.BoundedFormulaω Empty n :=
  ⟨k, (blockFormula forcingThresholds η hη t).relabel (Sum.inr : Fin k → Empty ⊕ Fin k)⟩

/-- The closed block formula realizes exactly as the block formula. -/
theorem realize_closedBlockFormula_iff {P : Type w} [baseLanguage.{0}.Structure P]
    {η : Ordinal.{0}} (hη : η < ω₁) {k : ℕ} (t : StageType.{0} (blockStage η) k)
    (b : Fin k → P) :
    ((blockFormula forcingThresholds η hη t).relabel
        (Sum.inr : Fin k → Empty ⊕ Fin k)).Realize (Empty.elim : Empty → P) b ↔
      (blockFormula forcingThresholds η hη t).Realize b := by
  have h := BoundedFormulaω.realize_relabel_sumInr (M := P)
    (φ := blockFormula forcingThresholds η hη t) (xs := b)
  rw [show (b ∘ Fin.castAdd 0 : Fin k → P) = b from funext fun i ↦ congrArg b (Fin.ext rfl),
    show (b ∘ Fin.natAdd k : Fin 0 → P) = Fin.elim0 from funext fun i ↦ i.elim0] at h
  exact h

/-! ### The block reading -/

open Classical in
/-- The **block reading** of a structure at `λ_η`: a tuple is evaluated to a stage type whose
block formula it satisfies, if there is one, and to `none` otherwise. -/
noncomputable def blockReading {η : Ordinal.{0}} (hη : η < ω₁) (M : Type w)
    [baseLanguage.{0}.Structure M] : Realization.{0, w} (blockStage η) M where
  eval s := if h : ∃ t, (blockFormula forcingThresholds η hη t).Realize ⇑s then some h.choose
    else none

/-- **Local agreement of the block reading**, undefined evaluations included: on a substructure
`M₀` elementary for a fragment containing the closed block formulas at `λ_η`, a receiving model
expansion of `M₀` to `λ_η` is the pullback of the block reading of `M`. -/
theorem blockReading_comapRealization_eq {M : Type w} [baseLanguage.{0}.Structure M]
    {η : Ordinal.{0}} (hη : η < ω₁) {A : Fragment baseLanguage.{0}}
    (hA : ∀ (k : ℕ) (t : StageType.{0} (blockStage η) k), closedBlockFormula hη t ∈ A.toSet)
    {M₀ : baseLanguage.{0}.Substructure M} (hAe : AElementary A M₀.subtype)
    (e : ModelExpansion M₀ (blockStage η)) (he : e.1.HasFiniteCutReceiving) :
    e.1 = comapRealization (blockReading hη M) M₀.subtype.toEmbedding := by
  classical
  refine Realization.ext fun {k} s ↦ ?_
  have key : ∀ t, (blockFormula forcingThresholds η hη t).Realize
      ⇑(s.trans M₀.subtype.toEmbedding) ↔ e.1.eval s = some t := by
    intro t
    have h := hAe _ (hA k t) ⇑s
    rw [realize_closedBlockFormula_iff, realize_closedBlockFormula_iff] at h
    rw [show ⇑(s.trans M₀.subtype.toEmbedding) = ⇑M₀.subtype ∘ ⇑s from rfl, h,
      realize_blockFormula_iff_of_hasFiniteCutReceiving hη e he,
      Realization.covers_iff_eval]
  rw [comapRealization_eval]
  change e.1.eval s = if h : ∃ t, (blockFormula forcingThresholds η hη t).Realize
    ⇑(s.trans M₀.subtype.toEmbedding) then some h.choose else none
  split_ifs with hex
  · exact (key _).1 hex.choose_spec
  · rcases hs : e.1.eval s with _ | t₀
    · rfl
    · exact absurd ⟨t₀, (key t₀).2 hs⟩ hex

/-! ### The construction -/

/-- **Receiving expansions to the countable block stages**, the target form (see the module
documentation). -/
theorem existsReceivingBlockExpansionOfProcessRankTarget :
    ExistsReceivingBlockExpansionOfProcessRankTarget.{w} := by
  intro M _ hΦ hR η hη
  classical
  set E := (receivingExpansionDomain η)ᶜ with hEdef
  have hE : E.Countable := receivingExpansionDomain_compl_countable hη
  have hTc : (Set.range fun x : (Σ k, StageType.{0} (blockStage η) k) ↦
      closedBlockFormula hη x.2).Countable := by
    have := StageType.countable_sigma
      (InfinitaryLogic.setCountable_Iio_of_lt_omega1 _ (blockStage_lt_omega_one hη))
    exact Set.countable_range _
  let S : Set (Σ n, baseLanguage.{0}.BoundedFormulaω Empty n) :=
    insert ⟨0, baseLanguage.densitySentence.{0}⟩
      ((closedScottOfClass.{w} '' E) ∪
        Set.range fun x : (Σ k, StageType.{0} (blockStage η) k) ↦ closedBlockFormula hη x.2)
  have hS : S.Countable := ((hE.image _).union hTc).insert _
  have : Countable (Σ n, baseLanguage.{0}.Functions n) := countable_functions_of_isRelational
  have hA : ∀ (k : ℕ) (t : StageType.{0} (blockStage η) k),
      closedBlockFormula hη t ∈ (Fragment.generated S).toSet := fun k t ↦
    Fragment.subset_generated S (Set.mem_insert_of_mem _ (Set.mem_union_right _ ⟨⟨k, t⟩, rfl⟩))
  -- every finite set lies in a countable elementary piece with a receiving expansion
  have hloc : ∀ X : Finset M, ∃ M₀ : baseLanguage.{0}.Substructure M, (↑X : Set M) ⊆ M₀ ∧
      ∃ e : ModelExpansion M₀ (blockStage η), e.1.HasFiniteCutReceiving ∧
        e.1 = comapRealization (blockReading hη M) M₀.subtype.toEmbedding := by
    intro X
    obtain ⟨M₀, hXM₀, hAe, hM₀⟩ := exists_countable_aElementary_substructure
      (Fragment.generated S) (X := (↑X : Set M)) X.countable_toSet
      (Fragment.generated_countable hS)
    have hΦ₀ : Sentenceω.Realize baseLanguage.densitySentence.{0} M₀ := by
      rw [Sentenceω.realize_def]
      have h := hAe _ (Fragment.subset_generated S (Set.mem_insert _ _)) Fin.elim0
      rw [show (⇑M₀.subtype ∘ (Fin.elim0 : Fin 0 → M₀)) = Fin.elim0 from
        funext fun i ↦ i.elim0] at h
      exact h.1 ((Sentenceω.realize_def _ _).1 hΦ)
    obtain ⟨c, hc, ⟨f⟩⟩ := MainTheorem.exists_mem_modelsOf_densitySentence_equiv M₀ hΦ₀
    have hdom : Quotient.mk _ ⟨c, hc⟩ ∈ receivingExpansionDomain η := by
      by_contra hq
      exact (iSup_orbitRank_lt_omegaOne_of_aElementary hAe hc f
        (Fragment.subset_generated S (Set.mem_insert_of_mem _
          (Set.mem_union_left _ ⟨_, hq, rfl⟩)))).not_ge hR
    obtain ⟨e₀, he₀⟩ := (mem_receivingExpansionDomain_iff ⟨c, hc⟩).1 hdom
    let e : ModelExpansion M₀ (blockStage η) :=
      @ModelExpansion.map ℕ c.toStructure _ M₀ _ e₀
        (@Language.Equiv.symm baseLanguage.{0} M₀ ℕ _ c.toStructure f)
    have he : e.1.HasFiniteCutReceiving :=
      (Realization.hasFiniteCutReceiving_map_iff _).2 he₀
    exact ⟨M₀, hXM₀, e, he, blockReading_comapRealization_eq hη hA hAe e he⟩
  -- the block reading is a receiving model expansion of `M`
  have hloc' : ∀ X : Finset M, ∃ (N : Type w) (g : N ↪ M), (↑X : Set M) ⊆ Set.range g ∧
      (comapRealization (blockReading hη M) g).IsReceivingModel := by
    intro X
    obtain ⟨M₀, hX, e, he, heq⟩ := hloc X
    refine ⟨M₀, M₀.subtype.toEmbedding, fun x hx ↦ ⟨⟨x, hX hx⟩, rfl⟩, ?_⟩
    rw [← heq]
    exact ⟨e.2.isModel, he⟩
  have hmodel : (blockReading hη M).IsModel := isModel_of_forall_comap fun X ↦ by
    obtain ⟨N, g, hX, hN⟩ := hloc' X
    exact ⟨N, g, hX, hN.1⟩
  have hrec : (blockReading hη M).HasFiniteCutReceiving :=
    hasFiniteCutReceiving_of_forall_comap fun X ↦ by
      obtain ⟨N, g, hX, hN⟩ := hloc' X
      exact ⟨N, g, hX, hN.2⟩
  have hstr := toStructure_reduce_eq_of_forall_comap (R := blockReading hη M) fun X ↦ by
    obtain ⟨M₀, hX, e, -, heq⟩ := hloc X
    exact ⟨M₀, inferInstance, M₀.subtype, fun x hx ↦ ⟨⟨x, hX hx⟩, rfl⟩, e, heq⟩
  exact ⟨⟨blockReading hη M, hmodel, hstr⟩, hrec⟩

/-- **The reconstruction**, the target form: receiving expansions to the countable block stages
(`existsReceivingBlockExpansionOfProcessRankTarget`) glue to one at `ω₁`
(`existsReceivingExpansionOfProcessRankTarget_of_block`). -/
theorem existsReceivingExpansionOfProcessRankTarget :
    ExistsReceivingExpansionOfProcessRankTarget.{w} :=
  existsReceivingExpansionOfProcessRankTarget_of_block
    existsReceivingBlockExpansionOfProcessRankTarget

end VaughtConjecture.ProcessRank
