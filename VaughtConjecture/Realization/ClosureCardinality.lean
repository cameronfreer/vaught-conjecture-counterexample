import VaughtConjecture.Closure.ExteriorOrder
import VaughtConjecture.Language.Density
import VaughtConjecture.Realization.Closure
import VaughtConjecture.Realization.Transport

/-!
# Cardinality and the exterior order for the canonical closure (statements)

The canonical finite hull of an exactly consistent covering realization is generated by two points
(`exists_subset_card_le_two_finiteHull_eq`), which is InfinitaryLogic's whole-hull two-generation
hypothesis for `Realization.hullClosure` (`exists_subset_card_le_two_hullClosure_eq`).  So the
cardinal layer of InfinitaryLogic's `TwoGeneratorCardinality` applies to the canonical closure
`Realization.closure`, and the generic targets of `VaughtConjecture.Closure.ExteriorOrder` apply
to it at `R.hullClosure hR hc`.

Proved here, by instantiation of InfinitaryLogic:

* `MkLeAlephOneTarget`: the carrier of an exactly consistent covering realization, at any stage,
  has at most `ℵ₁` points (`mk_le_aleph_one`);
* `MkLeAlephOneOfRealizeDensitySentenceTarget`: every model of the density sentence has at most
  `ℵ₁` points (through `baseLanguage.realize_densitySentence_iff`);
* `CountableOfIsClosedNeUnivTarget`: proper closed sets are countable
  (`countable_of_isClosed_ne_univ`);
* `SurjectiveOfIsClosedRangeTarget`: an embedding of an uncountable type with closed range is
  onto (`surjective_of_isClosed_range`).

Stated and open:

* `ImageClosureOfEvalEmbeddingTarget` (embedding form): an embedding sending every typed tuple to
  a tuple of the same type carries closures to closures and has closed range;
* `EqMapOfEvalEmbeddingTarget` (isomorphism form): an embedding of an uncountable realization
  keeping every evaluation (`none` included) is a bijection carrying one realization to the other;
* `ExteriorOrderIsLinearTarget`: above an infinite closed set the exterior relation of the
  canonical closure is a linear order (a `Prop`; no `LinearOrder` instance).

Every target is a given-model statement: it is about every realization (or every model of the
density sentence) satisfying its hypotheses, and asserts no existence of models.  Root change and
the common root for realizations are the generic targets at `R.hullClosure hR hc`.
-/

universe u v w

namespace VaughtConjecture.Realization

open InfinitaryLogic.FiniteSupportClosure

variable {α : Ordinal.{u}} {M : Type v} {R : Realization.{u, v} α M}

/-- **Whole-hull two-generation for the canonical hull**: the canonical hull of a finite set is
the canonical hull of at most two of its points, in the form of InfinitaryLogic's generation
hypothesis (`exists_subset_card_le_two_finiteHull_eq`). -/
theorem exists_subset_card_le_two_hullClosure_eq (hR : R.IsConsistent) (hc : R.IsCovering)
    (S : Finset M) : ∃ T ⊆ S, T.card ≤ 2 ∧ R.hullClosure hR hc T = R.hullClosure hR hc S :=
  exists_subset_card_le_two_finiteHull_eq hR hc S

/-! ### Cardinal bounds -/

/-- **Target: at most `ℵ₁` points.**  The carrier of an exactly consistent covering realization,
at any stage, has cardinality at most `ℵ₁`: InfinitaryLogic's `mk_le_aleph_one` for the canonical
finite hull, which is generated by two points.  No countability of the stage is assumed.
Given-model statement.  Proved (`Realization.mkLeAlephOneTarget`). -/
def MkLeAlephOneTarget : Prop :=
  ∀ ⦃α : Ordinal.{u}⦄ ⦃M : Type v⦄ (R : Realization.{u, v} α M), R.IsConsistent →
    R.IsCovering → Cardinal.mk M ≤ Cardinal.aleph 1

/-- **At most `ℵ₁` points**, the target form. -/
theorem mkLeAlephOneTarget : MkLeAlephOneTarget.{u, v} := fun _ _ R hR hc ↦
  mk_le_aleph_one (R.hullClosure hR hc) (exists_subset_card_le_two_hullClosure_eq hR hc)

/-- **Target: every model of the density sentence has at most `ℵ₁` points**, on a carrier in any
universe: `MkLeAlephOneTarget` for `baseLanguage.toRealization M`, which is exactly consistent and
covering by `baseLanguage.realize_densitySentence_iff`.  Given-model statement.  Proved
(`Realization.mkLeAlephOneOfRealizeDensitySentenceTarget`). -/
def MkLeAlephOneOfRealizeDensitySentenceTarget : Prop :=
  ∀ ⦃M : Type w⦄ [baseLanguage.{u}.Structure M], baseLanguage.densitySentence.{u}.Realize M →
    Cardinal.mk M ≤ Cardinal.aleph 1

/-- **Every model of the density sentence has at most `ℵ₁` points**, the target form. -/
theorem mkLeAlephOneOfRealizeDensitySentenceTarget :
    MkLeAlephOneOfRealizeDensitySentenceTarget.{w, u} := by
  intro M _ h
  obtain ⟨-, -, hR, hc, -⟩ := (baseLanguage.realize_densitySentence_iff M).mp h
  exact mkLeAlephOneTarget (baseLanguage.toRealization M) hR hc

/-- **Target: proper closed sets are countable.**  In an exactly consistent covering realization,
every closed set of the canonical closure other than the whole carrier is countable
(InfinitaryLogic's `countable_of_isClosed_ne_univ`).  Given-model statement.  Proved
(`Realization.countableOfIsClosedNeUnivTarget`). -/
def CountableOfIsClosedNeUnivTarget : Prop :=
  ∀ ⦃α : Ordinal.{u}⦄ ⦃M : Type v⦄ (R : Realization.{u, v} α M) (hR : R.IsConsistent)
    (hc : R.IsCovering) ⦃A : Set M⦄, (R.closure hR hc).IsClosed A → A ≠ Set.univ → A.Countable

/-- **Proper closed sets are countable**, the target form. -/
theorem countableOfIsClosedNeUnivTarget : CountableOfIsClosedNeUnivTarget.{u, v} :=
  fun _ _ R hR hc _ hA hne ↦
    countable_of_isClosed_ne_univ (R.hullClosure hR hc)
      (exists_subset_card_le_two_hullClosure_eq hR hc) hA hne

/-- **Target: a closed embedding of an uncountable type is onto.**  In an exactly consistent
covering realization on `M`, an embedding `e : N ↪ M` of an uncountable type whose range is closed
for the canonical closure is surjective (InfinitaryLogic's `surjective_of_isClosed_range`).  The
source carries no realization; closedness of the range is a hypothesis.  Given-model statement.
Proved (`Realization.surjectiveOfIsClosedRangeTarget`). -/
def SurjectiveOfIsClosedRangeTarget : Prop :=
  ∀ ⦃α : Ordinal.{u}⦄ ⦃M : Type v⦄ ⦃N : Type w⦄ [Uncountable N] (R : Realization.{u, v} α M)
    (hR : R.IsConsistent) (hc : R.IsCovering) (e : N ↪ M),
      (R.closure hR hc).IsClosed (Set.range e) → Function.Surjective e

/-- **A closed embedding of an uncountable type is onto**, the target form. -/
theorem surjectiveOfIsClosedRangeTarget : SurjectiveOfIsClosedRangeTarget.{u, v, w} :=
  fun _ _ _ _ R hR hc e hclosed ↦
    surjective_of_isClosed_range (R.hullClosure hR hc)
      (exists_subset_card_le_two_hullClosure_eq hR hc) e hclosed

/-! ### Embeddings keeping evaluations -/

/-- **Target: embeddings keeping typed tuples typed commute with the closure** (embedding form).
Let `R` on `M` and `R'` on `N` be exactly consistent and covering, and let `e : M ↪ N` send every
typed tuple of `R` to a tuple of `R'` with the same type; untyped tuples are unconstrained.  Then
`e` carries the canonical closure in `R` of every set onto the canonical closure in `R'` of its
image, and the range of `e` is closed in `R'`.  Given-model statement.  Stated; open. -/
def ImageClosureOfEvalEmbeddingTarget : Prop :=
  ∀ ⦃α : Ordinal.{u}⦄ ⦃M : Type v⦄ ⦃N : Type w⦄ (R : Realization.{u, v} α M)
    (R' : Realization.{u, w} α N) (hR : R.IsConsistent) (hc : R.IsCovering)
    (hR' : R'.IsConsistent) (hc' : R'.IsCovering) (e : M ↪ N),
    (∀ ⦃n : ℕ⦄ (t : Fin n ↪ M) (p : StageType.{u} α n), R.eval t = some p →
      R'.eval (t.trans e) = some p) →
      (∀ A : Set M, e '' R.closure hR hc A = R'.closure hR' hc' (e '' A)) ∧
        (R'.closure hR' hc').IsClosed (Set.range e)

/-- **Target: evaluation-keeping embeddings of uncountable realizations are isomorphisms**
(isomorphism form).  If `R` on an uncountable `M` and `R'` on `N` are exactly consistent and
covering, and `e : M ↪ N` keeps every evaluation (`none` included), then `e` is a bijection `σ`
and `R'` is the transport of `R` along `σ`.  Given-model statement.  Stated; open. -/
def EqMapOfEvalEmbeddingTarget : Prop :=
  ∀ ⦃α : Ordinal.{u}⦄ ⦃M : Type v⦄ ⦃N : Type w⦄ [Uncountable M] (R : Realization.{u, v} α M)
    (R' : Realization.{u, w} α N), R.IsConsistent → R.IsCovering → R'.IsConsistent →
    R'.IsCovering → ∀ e : M ↪ N, (∀ ⦃n : ℕ⦄ (t : Fin n ↪ M), R'.eval (t.trans e) = R.eval t) →
      ∃ σ : M ≃ N, ⇑σ = ⇑e ∧ R' = R.map σ

/-! ### The exterior order of a realization -/

/-- **Target: the exterior order of a realization is linear.**  In an exactly consistent covering
realization, above an infinite closed set `B` of the canonical closure, the relation "`x` lies in
the closure of `B` with `y` added" is a linear order on the points outside `B`
(`Closure.ExteriorLinearOrderTarget` at the canonical hull, whose anti-exchange is
`finiteHull_antiExchange`).  This is a `Prop`; no `LinearOrder` instance is declared.
Given-model statement.  Stated; open. -/
def ExteriorOrderIsLinearTarget : Prop :=
  ∀ ⦃α : Ordinal.{u}⦄ ⦃M : Type v⦄ (R : Realization.{u, v} α M) (hR : R.IsConsistent)
    (hc : R.IsCovering) ⦃B : Set M⦄, (R.closure hR hc).IsClosed B → B.Infinite →
      IsLinearOrder {x : M // x ∉ B} fun x y ↦ x.1 ∈ R.closure hR hc (insert y.1 B)

end VaughtConjecture.Realization
